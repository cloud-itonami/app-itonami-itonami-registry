{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "observedOn",
    "method",
    "count",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "itonami.blueprint-sources.v1"
    },
    "observedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "repository",
          "commit",
          "visibility",
          "archived",
          "license",
          "keys",
          "payload",
          "digestStatus",
          "status",
          "authority",
          "runtime",
          "handlesUserDataOrExternalComms"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^blueprint/(network-awai/)?[A-Za-z0-9_.-]+$"
          },
          "repository": {
            "type": "string",
            "pattern": "^(cloud-itonami|network-awai)/[A-Za-z0-9_.-]+$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "visibility": {
            "const": "public"
          },
          "archived": {
            "type": "boolean"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "keys": {
            "type": "object",
            "required": [
              "blueprint"
            ],
            "additionalProperties": false,
            "properties": {
              "blueprint": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "isic": {
                "type": "string",
                "minLength": 1
              },
              "isco": {
                "type": "string",
                "minLength": 1
              },
              "cofog": {
                "type": "string",
                "minLength": 1
              },
              "classification": {
                "enum": [
                  "isic-rev4",
                  "isic-rev5",
                  "isco-08",
                  "cofog"
                ]
              }
            }
          },
          "payload": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "enum": [
                    "blueprint.edn",
                    "README.md",
                    "LICENSE",
                    "organization.edn",
                    "kotoba.app.edn",
                    "physics.edn",
                    "facts.edn"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "digestStatus": {
            "const": "verified"
          },
          "status": {
            "const": "repository-owned"
          },
          "authority": {
            "type": "object",
            "required": [
              "grants",
              "default"
            ],
            "additionalProperties": false,
            "properties": {
              "grants": {
                "const": false
              },
              "default": {
                "const": "blocked"
              }
            }
          },
          "runtime": {
            "enum": [
              "trusted-page-v1",
              "restricted-wasm-v1",
              "none",
              "unknown"
            ]
          },
          "handlesUserDataOrExternalComms": {
            "enum": [
              true,
              false,
              "unknown"
            ]
          }
        }
      }
    }
  }
}
