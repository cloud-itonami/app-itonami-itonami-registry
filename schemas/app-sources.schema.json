{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "observedOn",
    "method",
    "count",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "itonami.app-sources.v1"
    },
    "observedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "repository",
          "commit",
          "visibility",
          "archived",
          "license",
          "kind",
          "keys",
          "payload",
          "digestStatus",
          "status",
          "authority"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^app/[A-Za-z0-9_.-]+$"
          },
          "repository": {
            "type": "string",
            "pattern": "^(cloud-itonami|network-awai)/[A-Za-z0-9_.-]+$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "visibility": {
            "const": "public"
          },
          "archived": {
            "type": "boolean"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "keys": {
            "type": "object",
            "required": [
              "app"
            ],
            "additionalProperties": false,
            "properties": {
              "app": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "payload": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "enum": [
                    "README.md",
                    "AGENTS.md",
                    "LICENSE",
                    "NOTICE",
                    "MATURITY.md",
                    "manifest.edn",
                    "kotoba.app.edn",
                    "package.json",
                    "wrangler.jsonc",
                    "wrangler.toml",
                    "shadow-cljs.edn",
                    "deps.edn",
                    "nbb.edn",
                    "cljk-origin.edn"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "digestStatus": {
            "enum": [
              "verified",
              "unverified"
            ]
          },
          "status": {
            "const": "repository-owned"
          },
          "authority": {
            "type": "object",
            "required": [
              "grants",
              "default"
            ],
            "additionalProperties": false,
            "properties": {
              "grants": {
                "const": false
              },
              "default": {
                "const": "blocked"
              }
            }
          },
          "kind": {
            "enum": [
              "worker-app",
              "kotoba-app",
              "js-app",
              "clj-app",
              "other"
            ]
          }
        }
      }
    }
  }
}
