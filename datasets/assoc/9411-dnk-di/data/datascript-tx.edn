 #:association-rule{:id "di.purpose-statute-2"
                    :title "§ 2 stk. 1 states five statutory objects: to act for Danish business interests; to strengthen its competitiveness and reputation; to secure the freest possible conditions for management, production and sales; to work for good relations between company managements and employees; and to give DIO members financial support during industrial disputes"
                    :association "di"
                    :isic "9411"
                    :country "DNK"
                    :kind :constitutive-instrument
                    :url "https://www.danskindustri.dk/vi-radgiver-dig/di-dokumenter-for-virksomhed/publikationer/dis-vedtagter/"
