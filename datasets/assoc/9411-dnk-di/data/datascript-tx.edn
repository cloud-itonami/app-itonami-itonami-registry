 #:association-rule{:id "di.conflict-support-statute-7"
                    :title "§ 7: DI pays konfliktunderstøttelse to DIO members under a regulativ approved by the forretningsudvalg, for lawfully notified conflicts and for conflicts in breach of collective agreement alike; it is measured against the company's subscription-liable payroll and may not exceed the loss actually suffered"
                    :association "di"
                    :isic "9411"
                    :country "DNK"
                    :kind :constitutive-instrument
                    :url "https://www.danskindustri.dk/vi-radgiver-dig/di-dokumenter-for-virksomhed/publikationer/dis-vedtagter/"
                    :url-provenance :official-danskindustri-dk
