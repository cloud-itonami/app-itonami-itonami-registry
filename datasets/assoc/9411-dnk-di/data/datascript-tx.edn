                    :retrieved-at "2026-09-10"
                    :topic [:governance :constitution :labor]}
 #:association-rule{:id "di.general-assembly-statute-18"
                    :title "§ 18: the generalforsamling holds the highest authority in all DI matters and its lawful decisions bind every member; member companies appoint 300 delegates, apportioned by the proportionate weight of their subscription to DI in the calendar year before the ordinary annual general assembly"
                    :association "di"
                    :isic "9411"
                    :country "DNK"
                    :kind :constitutive-instrument
                    :url "https://www.danskindustri.dk/vi-radgiver-dig/di-dokumenter-for-virksomhed/publikationer/dis-vedtagter/"
                    :url-provenance :official-danskindustri-dk
