                    :topic [:governance :constitution]}
 #:association-rule{:id "di.sector-communities-statute-13"
                    :title "§ 13: the hovedbestyrelse, on the forretningsudvalg's recommendation, may establish tværgående branchefællesskaber for member companies with shared interests, likewise on approved standard statutes that bind them to DI's political guidelines"
