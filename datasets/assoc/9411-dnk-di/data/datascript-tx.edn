 #:association-rule{:id "di.da-obligations-statute-2-4"
                    :title "§ 2 stk. 4: by agreement with the DIOs, DI performs the tasks and assumes the obligations that follow from the DIOs' membership of DA (Dansk Arbejdsgiverforening) -- DI's own statutes place it beneath the DA layer for those duties"
                    :association "di"
                    :isic "9411"
                    :country "DNK"
                    :kind :constitutive-instrument
