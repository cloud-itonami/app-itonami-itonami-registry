                    :retrieved-at "2026-09-10"
                    :topic [:governance :constitution :labor]}
 #:association-rule{:id "di.regional-associations-statute-12"
                    :title "§ 12: the forretningsudvalg may establish regionalforeninger to gather member companies within regional areas; they run on standard statutes it has approved, must state that they respect political guidelines set by DI's governing bodies, and levy no separate subscription"
                    :association "di"
                    :isic "9411"
                    :country "DNK"
                    :kind :constitutive-instrument
                    :url "https://www.danskindustri.dk/vi-radgiver-dig/di-dokumenter-for-virksomhed/publikationer/dis-vedtagter/"
