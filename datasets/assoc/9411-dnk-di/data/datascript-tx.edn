                    :retrieved-at "2026-09-10"
                    :topic [:governance :constitution]}
 #:association-rule{:id "di.main-board-statute-19"
                    :title "§ 19: the hovedbestyrelse sets the political guidelines for DI's work and, for DIO members, holds the competence to decide on lockout and other collective industrial action; it adopts DI's budget and must have the audited annual report before it by the end of April"
                    :association "di"
                    :isic "9411"
                    :country "DNK"
                    :kind :constitutive-instrument
                    :url "https://www.danskindustri.dk/vi-radgiver-dig/di-dokumenter-for-virksomhed/publikationer/dis-vedtagter/"
